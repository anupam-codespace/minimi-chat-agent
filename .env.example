# ==============================================================================
# MINIMI — PRODUCTION AI WEB RESEARCH AGENT CONFIGURATION
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Primary Persistence (PostgreSQL with pgvector / full-text search)
# If DATABASE_URL is not set or PostgreSQL is unavailable, Minimi gracefully
# falls back to its embedded persistent file-backed store at ./.data/minimi.db.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minimi
DEFAULT_USER_ID=usr_default
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: gemini (default), openai, anthropic, groq
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini API (Recommended for production-grade speed and accuracy)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq API (High-speed open models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Web Search Provider Configuration
# Supported providers: tavily (default), brave, serper, duckduckgo (zero-key fallback)
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=tavily

# Tavily AI Search (Recommended for structured research and rich citations)
TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search API (Alternative)
BRAVE_API_KEY=your_brave_api_key_here

# Serper (Google Search API alternative)
SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------------------
# Agent Budgets, Timeouts, and Guardrails
# ------------------------------------------------------------------------------
MAX_SEARCH_QUERIES=3
MAX_SOURCES_PER_QUERY=5
SEARCH_TIMEOUT_MS=8000
FETCH_PAGE_TIMEOUT_MS=5000
RATE_LIMIT_MAX_PER_MINUTE=60
MAX_CONTENT_CHARS_PER_PAGE=15000

